<div class="card mb-4">
    <div class="card-body d-flex gap-4">
        <img
            class="img-responsive center-block mb-5"
            src="{{user.image}}"
            style="width: 250px; transition: opacity 0.5s; opacity:0;"
            onload="this.style.opacity=1;"
        />
        <div>
            <ul class="list-unstyled">
                <li><strong>{{user.name}}</strong></li>
                <li>{{user.email}}</li>
                <li><strong>{{count}} 已評論餐廳</strong></li>
            </ul>
            <a class="btn btn-primary" href="/users/{{user.id}}/edit">Edit</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">{{count}} 已評論餐廳</div>
    <div class="flex card-body">
        {{#each user.Comments}}
            <img
                class="img-responsive center-block mb-5"
                src="{{this.Restaurant.image}}"
                style="width: 100px; transition: opacity 0.5s; opacity:0;"
                onload="this.style.opacity=1;"
            />
        {{/each}}
    </div>
</div>